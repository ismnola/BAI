[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = git@gitlab.opt.intranet:DMG/boite-a-idees.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "master"]
	remote = origin
	merge = refs/heads/master
[gui]
	wmstate = normal
	geometry = 1322x693+190+190 254 315
[branch "DEV"]
	remote = origin
	merge = refs/heads/DEV
	vscode-merge-base = origin/DEV
[branch "Tailwind_br"]
	vscode-merge-base = origin/master
	remote = origin
	merge = refs/heads/Tailwind_br
